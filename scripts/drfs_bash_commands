;;;;;;;;;;;;;;;;;;;;;;;
;  drfs_bash_commands
;;;;;;;;;;;;;;;;;;;;;;;
;
; script to call in a bash shell for executing IDL commands to create DRFS files
;
; cmdline arguments are:
;    filename_prefix
;    working_dir
;    component_dir  *** Note: this must end with '/' ***
;    ns, nl, nb (integers)
;    date, year (dummy arguments whose value doesn't matter in practice)
;    h, v   (MODIS tile ID)
;    thresh (variable used in DRFS IDL code)
;
;  which are used to construct:
;    full_input_filename
;    full_prefix
;    zenith_filename
;    azimuth_filename

;;;;;;;;;;;;;;;;;;;;;;;
; Example invocation:
;  idl drfs_bash_commands -idl_startup drfs_idl_startup.bat -args <dir_with_IDL_code> <filename_prefix> <working_dir> <component_dir_with_slash> <ns> <nl> <nb> <date> <year> <modis_tile_h> <modis_tile_v> <thresh>
;
; Example with variable names for a dev
;  idl drfs_bash_commands -idl_startup drfs_idl_startup.bat -args MOD09GA.A2025090.h08v04.061.2025091013655.NRT /scratch/alpine/scotts/scagdrfs/working/2025.03.31/h08v04 /pl/active/daac-production/jpl_DRFS_Components/ 2400 2400 7 001 1900 08 04 1
;;;;;;;;;;;;;;;;;;;;;;;


; NOTES -- Some background relevant to IDL quirks ---
;
;   -  Comments in IDL start with semicolons ';'
;
;   -  Strings in IDL are delineated with single quotes: 'string'
;        numbers are *not* delineated with quotes: 10 and '10' are different
;
;   -  .run causes compilation of the routines inside the indicated .pro file
;
;   -  I think this means of invoking these commands may require all operations
;       to occur on a single line.  I.e., no for loops, etc.
;
;   -   The only way I could get the routines to compile was
;       to use a .run command.  And the only way to do that in a
;       case-sensitive-way is to put the commands in a file and pass that
;       into the runtime env with the -idl_startup cmdline arg to the idl call.
;
;   -   fix() converts string to integer

;;;;;;;;;;;;;;;;;;;;;;;
; Process the command line arguments into the appropriate variables
;;;;;;;;;;;;;;;;;;;;;;;
args = command_line_args()

; Variables from arguments
filename_prefix = args(0)
working_dir = args(1)
component_dir = args(2)
ns = fix(args(3))
nl = fix(args(4))
nb = fix(args(5))
date = args(6)
year = args(7)
h = args(8)
v = args(9)
thresh = fix(args(10))

;;;;;;;;;;;;;;;;;;;;;;;
; Variables constructed from the command line arguments
;;;;;;;;;;;;;;;;;;;;;;;
full_filename = working_dir + '/' + filename_prefix + '.hdf'
full_prefix = working_dir + '/' + filename_prefix
zenith_filename = working_dir + '/' + filename_prefix + '.SolarZenith_1.dat'
azimuth_filename = working_dir + '/' + filename_prefix + '.SolarAzimuth_1.dat'

;;;;;;;;;;;;;;;;;;;;;;;
; Confirmation of variable values as-used in script
;;;;;;;;;;;;;;;;;;;;;;;
print,' '
print, 'File and directory values:'
print, '  Values from cmdline args:'
print, '    filename_prefix:  ', filename_prefix
print, '    working_dir:      ', working_dir
print, '    component_dir:    ', component_dir
print,'                ns:    ', ns
print,'                nl:    ', nl
print,'                nb:    ', nb
print,'              date:    ', date
print,'              year:    ', year
print,'                 h:    ', h
print,'                 v:    ', v
print,'            thresh:    ', thresh
print, '  Values calculated from args:'
print, '    full_filename:    ', full_filename
print, '    full_prefix:      ', full_prefix
print, '    zenith_filename:  ', zenith_filename
print, '    azimuth_filename: ', azimuth_filename
print,' '

;;;;;;;;;;;;;;;;;;;;;;;
;;;;; Original info passed to run-drfs-idl.sh (for reference)
;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;./tasks/run-drfs-idl.sh -h /scratch/alpine/scotts/scagdrfs/working/2025.03.31/h08v04/MOD09GA.A2025090.h08v04.061.2025091013655.NRT.hdf -c /pl/active/daac-production/jpl_DRFS_Components -w /scratch/alpine/scotts/scagdrfs/working/2025.03.31/h08v04

;;;;; NOTE: DRFS routines are provided with invocation of -idl_startup file

;;;;;;;;;;;;;;;;;;;;;;;
;;;;; drfs_hdf_solar()
;;;;;;;;;;;;;;;;;;;;;;;
; This command creates two files of the form:
;   MOD09GA.A2025090.h08v04.061.2025091013655.NRT.SolarZenith_1.dat
;   MOD09GA.A2025090.h08v04.061.2025091013655.NRT.SolarAzimuth_1.dat
; ... in the same directory as the input file
; this routine is nearly instantaneous to run
;
;;;;; Sample original command:
; drfs_hdf_solar(infile=/scratch/alpine/scotts/scagdrfs/working/2025.03.31/h08v04/MOD09GA.A2025090.h08v04.061.2025091013655.NRT.hdf)

print,'In IDL, calling drfs_hdr_solar()...'
drfs_hdf_solar,in_file=full_filename

;;;;;;;;;;;;;;;;;;;;;;;
;;;;; mod_drfs_v1_v2()
;;;;;;;;;;;;;;;;;;;;;;;
; This command takes a while to run (~11 min on interactive node on alpine)
; This command creates three files of the form:
;   MOD09GA.A2025090.h08v04.061.2025091013655.NRT.deltavis.dat
;   MOD09GA.A2025090.h08v04.061.2025091013655.NRT.forcing.dat
;   MOD09GA.A2025090.h08v04.061.2025091013655.NRT.drfs.grnsz.dat

print,'In IDL, calling mod_drfs_v1_2()...'
mod_drfs_v1_2, dir=working_dir, comps_dir=component_dir, file=full_filename, outfile=filename_prefix, zenithfile=zenith_filename, azimuthfile=azimuth_filename, ns=ns, nl=nl, nb=nb, date=date, year=year, h=h, v=v, thresh=thresh


;;;;;;;;;;;;;;;;;;;;;;;
;;;;; And the final cleanse operations (fast)
;;;;;;;;;;;;;;;;;;;;;;;
print,'In IDL, calling moddrfs_cleanse()...'
moddrfs_cleanse, prefix=full_prefix, ns=2400, nl=2400, mod09ga=full_filename


;;;;;;;;;;;;;;;;;;;;;;;
; This 'exit' statement is necessary to exit the IDL interpreter
;   and return execution to the (bash) shell
; Note: If something goes wrong with IDL, this batch script might
;       hang without returning a value to the shell.
;       This might mean this should be run with "timeout"
;       or similar to limit the amount of time this script runs.
;;;;;;;;;;;;;;;;;;;;;;;
exit
